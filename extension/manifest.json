{
  "manifest_version": 3,
  "name": "TailorSend Fill",
  "version": "0.2.0",
  "description": "Fill company apply forms from TailorSend answers and attach resume/cover PDFs, then review and submit yourself.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TailorSend Fill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["http://localhost:3000/*", "https://tailorsend.cc/*", "https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://tailorsend.cc/*", "https://*.tailorsend.cc/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost:3000/*", "https://tailorsend.cc/*", "https://*.tailorsend.cc/*"],
      "js": ["content/filler.js"],
      "run_at": "document_idle"
    }
  ]
}
